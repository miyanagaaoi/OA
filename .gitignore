# ---- 工具缓存与临时产物（可再生，不入库）----
.cache/
node_modules/
*.log
*.tmp

# ---- 打包产物（如需分发请显式加入）----
*.tgz

# ---- 操作系统杂物 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- 编辑器/IDE ----
.vscode/
.idea/
*.swp

# ---- 后端（oa-server，Maven）----
oa-server/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties

# ---- 前端（oa-web，Vite）----
oa-web/dist/
oa-web/node_modules/
oa-web/.vite/
oa-web/*.tsbuildinfo
oa-web/.env.local
oa-web/.env.*.local

# ---- 本地运行数据（数据库、附件、签名图、日志）----
# 注意：runtime/ 下**只忽略运行数据**；启停脚本是交付物，要入库（用 runtime/* + 白名单反选）
oa-deploy/runtime/*
!oa-deploy/runtime/*.ps1
!oa-deploy/runtime/*.cmd
*.pid
*.hprof

# ---- 本地环境变量与密钥（含口令，禁止入库；模板 .env.example 保留）----
.env
oa-deploy/.env
oa-deploy/nginx/certs/
oa-deploy/backup/

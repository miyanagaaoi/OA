# 开发环境（.env.development）
# 说明：Vite 代理把 /api/v1/** 转发到本地 Spring Boot，前端自身不直连后端。
VITE_APP_TITLE=集团OA审批系统
VITE_APP_ENV=development

# 统一 API 前缀（与 normify 契约一致，全部落在 /api/v1 下）
VITE_API_BASE_URL=/api/v1
# 本地后端地址（doc/tech-design.md §2：Nginx → 应用服务 :8080）
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# 会话 Cookie（REQ-NFR-006：HttpOnly + Secure + SameSite=Lax，由服务端下发，前端只读其存在性）
VITE_SESSION_COOKIE_NAME=OA_SESSION
# 开发环境允许 HTTP，生产必须 HTTPS（REQ-NFR-005）
VITE_FORCE_HTTPS=false

# 无后端时的接口降级演示（阶段 1 骨架：页面用内置演示数据渲染，接口一就绪即可关闭）
VITE_USE_MOCK=true

# 水印默认透明度，取值必须落在 DESIGN.md 规定的 5%–8% 区间
VITE_WATERMARK_OPACITY=0.06

# 生产环境（.env.production）
# 说明：产物为纯静态，由 Nginx 托管并反向代理 /api/v1/**（doc/tech-design.md §7）。
VITE_APP_TITLE=集团OA审批系统
VITE_APP_ENV=production

VITE_API_BASE_URL=/api/v1
# 生产走同源 Nginx 反代，不需要开发代理
VITE_API_PROXY_TARGET=

VITE_SESSION_COOKIE_NAME=OA_SESSION
# REQ-NFR-005：全站 HTTPS；非 HTTPS 访问时前端拒绝继续（见 src/main.ts 的传输层守卫）
VITE_FORCE_HTTPS=true

# 生产必须对接真实后端
VITE_USE_MOCK=false

# 水印透明度（DESIGN.md 规定区间 5%–8%，此处取中值 6%）
VITE_WATERMARK_OPACITY=0.06

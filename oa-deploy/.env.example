# 复制为 .env 后填写（.env 已被 .gitignore 忽略，禁止入库）
# 用法：cp .env.example .env && vi .env

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=请改成强口令
MYSQL_DATABASE=oa
MYSQL_USER=oa
MYSQL_PASSWORD=请改成强口令

# ---- 缓存/会话 ----
REDIS_PASSWORD=请改成强口令

# ---- 应用 ----
SPRING_PROFILES_ACTIVE=prod
APP_TAG=prod-2026.10
OA_LOG_LEVEL=INFO
JAVA_OPTS=-Xms512m -Xmx1536m -XX:+UseG1GC -Duser.timezone=Asia/Shanghai

# ---- 邮件（一期唯一主动提醒通道，PRD 6.7）----
OA_MAIL_HOST=smtp.example.internal
OA_MAIL_PORT=25
OA_MAIL_USERNAME=
OA_MAIL_PASSWORD=
OA_MAIL_FROM=oa-noreply@example.com

# ---- 存储与限制（与 doc/enums.md §12.1 一致）----
OA_STORAGE_MAX_FILE_MB=50
OA_ATTACHMENT_MAX_COUNT=20
OA_SESSION_MAX_DEVICES=3
OA_REMEMBER_ME_DAYS=7
OA_LOGIN_FAIL_LIMIT=5
OA_LOGIN_LOCK_MINUTES=15
